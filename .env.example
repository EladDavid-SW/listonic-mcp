# Copy to .env for local testing only (.env is git-ignored). Placeholders only —
# never commit real values. On Render, set these under Environment instead.

# --- Listonic account (required) -------------------------------------------
LISTONIC_EMAIL=you@example.com
LISTONIC_PASSWORD=change-me
# Optional: pin a default list id (see the get_lists tool); empty = first list
LISTONIC_LIST_ID=

# --- Transport ---------------------------------------------------------------
# stdio (local clients) or http (Streamable HTTP at /mcp). The Docker image defaults to http.
MCP_TRANSPORT=http
# Render injects PORT automatically; 8000 is the local default.
PORT=8000
HOST=0.0.0.0

# --- Remote endpoint auth (required for http) --------------------------------
# Random secret, at least 32 chars. Generate with:  openssl rand -hex 32
MCP_AUTH_TOKEN=replace-with-output-of-openssl-rand-hex-32
# true = also accept https://<host>/mcp/<MCP_AUTH_TOKEN> for clients that cannot
# send an Authorization header. Off by default; see README before enabling.
MCP_ALLOW_PATH_TOKEN=false
